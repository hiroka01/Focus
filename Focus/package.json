{
  "name": "focus",
  "private": true,
  "version": "1.0.0",
  "description": "Focus workspace app with a serverless SQLite (Cloudflare D1) backend",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-assets.js",
    "db:migrate:local": "wrangler d1 migrations apply focus-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply focus-db --remote",
    "dev": "npm run build && npm run db:migrate:local && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test test/api.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}

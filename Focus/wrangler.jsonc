{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "focus",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "triggers": {
    "crons": ["* * * * *"]
  },

  // The frontend (copied into ./dist by `npm run build`) is served as static assets.
  // The Worker only runs for the API routes below.
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*", "/healthz"]
  },

  // SQLite database. After `wrangler d1 create focus-db`, paste the printed database_id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "focus-db",
      "database_id": "744ca917-aaa6-41c3-a3cc-6e3360efad65",
      "migrations_dir": "migrations"
    }
  ],

  // Storage for uploaded PDF/EPUB files (create with `wrangler r2 bucket create focus-books`).
  "r2_buckets": [
    { "binding": "BOOKS", "bucket_name": "focus-books" }
  ],

  // Frontend is hosted on different origin
  "vars": { "CORS_ORIGINS": "https://hiroka01.github.io" }
}
